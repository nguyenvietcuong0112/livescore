<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color (Red Accent) -->
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color (Blue selected state) -->
        <item name="colorSecondary">@color/accent_green_secondary</item>
        <item name="colorSecondaryVariant">@color/accent_green</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar and navigation bar customization for Light Theme -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        
        <!-- Light status and navigation bar to force dark icons (Required on Android 6.0+) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        
        <!-- Custom typography and colors -->
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>
</resources>