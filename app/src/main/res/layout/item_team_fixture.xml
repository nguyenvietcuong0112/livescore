<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardFixture"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/divider_dark"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Top League & Date Row -->
        <ImageView
            android:id="@+id/ivLeagueLogo"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/tvLeagueName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/ivLeagueLogo"
            app:layout_constraintEnd_toStartOf="@id/tvMatchDate"
            app:layout_constraintStart_toEndOf="@id/ivLeagueLogo"
            app:layout_constraintTop_toTopOf="@id/ivLeagueLogo"
            tools:text="Premier League - Round 38" />

        <TextView
            android:id="@+id/tvMatchDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/ivLeagueLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivLeagueLogo"
            tools:text="2026-05-24" />

        <View
            android:id="@+id/dividerHeader"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/divider_dark"
            app:layout_constraintTop_toBottomOf="@id/ivLeagueLogo" />

        <!-- Match Teams & Score Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/dividerHeader">

            <!-- Home Team -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHomeTeamName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Liverpool" />

                <ImageView
                    android:id="@+id/ivHomeTeamLogo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="8dp"
                    android:scaleType="fitCenter"
                    tools:src="@android:drawable/ic_menu_gallery" />

            </LinearLayout>

            <!-- Score Center Box -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_green"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="2 - 1" />

                <TextView
                    android:id="@+id/tvStatusShort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    tools:text="FT (1-0)" />

            </LinearLayout>

            <!-- Away Team -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAwayTeamLogo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter"
                    tools:src="@android:drawable/ic_menu_gallery" />

                <TextView
                    android:id="@+id/tvAwayTeamName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="@color/text_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Brentford" />

            </LinearLayout>

            <!-- Result W/D/L Badge -->
            <TextView
                android:id="@+id/tvResultBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_date_pill"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:backgroundTint="#00E676"
                tools:text="W" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
