<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider_dark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Round Stage Info -->
            <TextView
                android:id="@+id/tvFixtureRound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRẬN KHAI MẠC"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/sf_pro"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/layoutRightActions" />

            <!-- Stadium/Location Info -->
            <TextView
                android:id="@+id/tvFixtureStadium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estadio Azteca, Mexico City"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="@font/sf_pro"
                app:layout_constraintTop_toBottomOf="@id/tvFixtureRound"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/layoutRightActions" />



            <!-- Middle Row: Team 1 - VS - Team 2 -->
            <LinearLayout
                android:id="@+id/layoutTeams"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvFixtureStadium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/layoutRightActions">

                <!-- Team 1 -->
                <TextView
                    android:id="@+id/tvFixtureTeam1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="🇲🇽 Mexico"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/sf_pro" />

                <!-- Team 1 Logo -->
                <ImageView
                    android:id="@+id/ivFixtureHomeLogo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Home Logo"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/text_muted"
                    android:layout_gravity="center_vertical" />

                <!-- VS Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="1dp"
                    app:cardBackgroundColor="@color/card_dark"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider_dark"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvVS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="4dp"
                        android:text="VS"
                        android:textColor="@color/accent_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/sf_pro" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Team 2 Logo -->
                <ImageView
                    android:id="@+id/ivFixtureAwayLogo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Away Logo"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/text_muted"
                    android:layout_gravity="center_vertical" />

                <!-- Team 2 -->
                <TextView
                    android:id="@+id/tvFixtureTeam2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:text="🇪🇨 Ecuador"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/sf_pro" />

            </LinearLayout>

            <!-- Bottom Row: Kickoff Time (Center) -->
            <TextView
                android:id="@+id/tvFixtureTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="20:00"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="@font/sf_pro"
                app:layout_constraintTop_toBottomOf="@id/layoutTeams"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/layoutRightActions" />

            <!-- Right Action Group -->
            <LinearLayout
                android:id="@+id/layoutRightActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:paddingEnd="4dp">

                <!-- AI Predict Button (Icon only) -->
                <FrameLayout
                    android:id="@+id/layoutPredictButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/btnPredict"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ai_robot"
                        app:tint="@color/primaryBlue"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Separate Reminder Icon (Bell) for upcoming matches -->
                    <ImageView
                        android:id="@+id/ivReminder"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Reminder Alarm"
                        android:src="@drawable/ic_bell"
                        android:visibility="gone" />

                    <!-- Separate Favorite Icon aligned to the right edge -->
                    <ImageView
                        android:id="@+id/ivFavorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Favorite"
                        android:src="@drawable/ic_favorite_border"
                        android:padding="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        app:tint="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>



    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
