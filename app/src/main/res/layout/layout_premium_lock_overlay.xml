<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#EC0B0E13"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Locked feature"
            app:srcCompat="@drawable/ic_premium_lock" />

        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MỞ KHÓA PREMIUM"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvLockSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tính năng này yêu cầu Premium. Hãy nâng cấp để theo dõi bản đồ radar, xu hướng tấn công &amp; số liệu thống kê thời gian thực không giới hạn!"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlockNow"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/accent_green"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Nâng cấp ngay"
            android:textColor="@color/bg_light"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
