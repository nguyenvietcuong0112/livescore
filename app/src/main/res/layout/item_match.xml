<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMatch"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider_dark"
    app:strokeWidth="1dp"
    app:rippleColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutLiveFinished"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Clickable area for Match Details (now centered) -->
            <LinearLayout
                android:id="@+id/layoutMatchDetailsClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Teams Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Home Team Name -->
                    <TextView
                        android:id="@+id/tvHomeName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/sf_pro"
                        tools:text="Shahrdari Noshahr" />

                    <!-- Home Team Logo -->
                    <ImageView
                        android:id="@+id/ivHomeLogo"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="12dp"
                        android:scaleType="fitCenter" />

                    <!-- Score Box -->
                    <LinearLayout
                        android:id="@+id/layoutScoreBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_score_box_blue">

                        <TextView
                            android:id="@+id/tvHomeScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primaryBlue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/sf_pro"
                            tools:text="4" />

                        <TextView
                            android:id="@+id/tvScoreSeparator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:text="-"
                            android:textColor="@color/primaryBlue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/sf_pro" />

                        <TextView
                            android:id="@+id/tvAwayScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primaryBlue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/sf_pro"
                            tools:text="2" />
                    </LinearLayout>

                    <!-- Away Team Logo -->
                    <ImageView
                        android:id="@+id/ivAwayLogo"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:scaleType="fitCenter" />

                    <!-- Away Team Name -->
                    <TextView
                        android:id="@+id/tvAwayName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/sf_pro"
                        tools:text="Shahrdari Noshahr" />

                </LinearLayout>

                <!-- Divider Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="12dp" />

                <!-- Bottom Status Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvMatchStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/sf_pro"
                        tools:text="08:00" />

                    <com.livescore.football.livescores.footballscores.ui.custom.LivePulseView
                        android:id="@+id/livePulse"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

                <!-- Live Scorers & Extra Info -->
                <LinearLayout
                    android:id="@+id/layoutLiveExtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvLiveScorers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:gravity="center"
                        tools:text="⚽ Saka 12' - ⚽ Palmer 28'" />

                    <TextView
                        android:id="@+id/tvLiveStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        tools:text="Possession: 56% - 44% | Shots: 14 - 8" />

                </LinearLayout>

            </LinearLayout>

            <!-- Keep references to legacy views to prevent compilation issues -->
            <LinearLayout
                android:id="@+id/layoutRightActions"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivReminder"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivFavoriteLegacy"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHomeRedCards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAwayRedCards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/statusDivider"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Favorite Icon for Live/Finished matches placed at bottom right -->
            <ImageView
                android:id="@+id/ivFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favorite Match"
                android:src="@drawable/ic_favorite_border"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Upcoming Layout -->
        <LinearLayout
            android:id="@+id/layoutUpcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Clickable area for Match Details -->
            <LinearLayout
                android:id="@+id/layoutMatchDetailsClickUpcoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                android:gravity="center_horizontal">

                <!-- Kickoff Time -->
                <TextView
                    android:id="@+id/tvMatchTimeUpcoming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primaryBlue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/sf_pro"
                    tools:text="23:30" />

                <!-- Teams Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <!-- Home Team Name -->
                    <TextView
                        android:id="@+id/tvHomeNameUpcoming"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/sf_pro"
                        tools:text="Shahrdari Noshahr" />

                    <!-- Home Team Logo -->
                    <ImageView
                        android:id="@+id/ivHomeLogoUpcoming"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="12dp"
                        android:scaleType="fitCenter" />

                    <!-- Separator -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/sf_pro" />

                    <!-- Away Team Logo -->
                    <ImageView
                        android:id="@+id/ivAwayLogoUpcoming"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:scaleType="fitCenter" />

                    <!-- Away Team Name -->
                    <TextView
                        android:id="@+id/tvAwayNameUpcoming"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/sf_pro"
                        tools:text="Shahrdari Noshahr" />

                </LinearLayout>

            </LinearLayout>

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="16dp" />

            <!-- Bottom Actions Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <!-- Supercomputer Pick Button Container -->
                <FrameLayout
                    android:id="@+id/layoutPredictButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <LinearLayout
                        android:id="@+id/btnPredict"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/bg_btn_predict_upcoming"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_ai_robot"
                            app:tint="@color/primaryBlue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/supercomputer_prediction"
                            android:textColor="@color/primaryBlue"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/sf_pro" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Right Actions (Reminder & Favorite) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical">

                    <!-- Reminder Icon -->
                    <ImageView
                        android:id="@+id/ivReminderUpcoming"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Reminder Alarm"
                        android:src="@drawable/ic_bell"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Favorite Icon -->
                    <ImageView
                        android:id="@+id/ivFavoriteUpcoming"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Favorite Match"
                        android:src="@drawable/ic_favorite_border"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
