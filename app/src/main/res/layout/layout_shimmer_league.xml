<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_color="@color/shimmer_base"
    app:shimmer_highlight_color="@color/shimmer_highlight">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="#F6F9FD"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#F8FAFF">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <!-- Left Media Container (rounded 8dp) -->
            <View
                android:id="@+id/shimmer_media"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:background="@color/shimmer_base"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Right App Icon Container -->
            <View
                android:id="@+id/shimmer_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:background="@color/shimmer_base"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/shimmer_media" />

            <!-- Headline/Title next to App Icon -->
            <View
                android:id="@+id/shimmer_headline"
                android:layout_width="0dp"
                android:layout_height="15dp"
                android:layout_marginStart="8dp"
                android:background="@color/shimmer_base"
                app:layout_constraintTop_toTopOf="@id/shimmer_icon"
                app:layout_constraintBottom_toBottomOf="@id/shimmer_icon"
                app:layout_constraintStart_toEndOf="@id/shimmer_icon"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Description/Body Text -->
            <View
                android:id="@+id/shimmer_body"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:background="@color/shimmer_base"
                app:layout_constraintTop_toBottomOf="@id/shimmer_icon"
                app:layout_constraintStart_toStartOf="@id/shimmer_icon"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/shimmer_body2"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:background="@color/shimmer_base"
                app:layout_constraintTop_toBottomOf="@id/shimmer_body"
                app:layout_constraintStart_toStartOf="@id/shimmer_icon"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Action Button / CTA -->
            <View
                android:id="@+id/shimmer_cta"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:background="@color/shimmer_base"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/shimmer_icon"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</com.facebook.shimmer.ShimmerFrameLayout>
