<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/transparent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingVertical="8dp">

        <!-- Avatar Circle -->
        <View
            android:id="@+id/ivPlayerAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:visibility="gone"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circle_avatar" />

        <!-- Player Details Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name, Badge and Percent Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvBullet"
                    tools:text="Dev Cường" />

                <TextView
                    android:id="@+id/tvBullet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#C4C9D2"
                    android:textSize="20sp"
                    app:layout_constraintStart_toEndOf="@id/tvPlayerName"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivTeamLogo" />

                <!-- Dynamic Team Logo -->
                <ImageView
                    android:id="@+id/ivTeamLogo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintStart_toEndOf="@id/tvBullet"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvTeamBadge"
                    tools:src="@drawable/bg_circle_avatar" />

                <!-- Dynamic Team Name -->
                <TextView
                    android:id="@+id/tvTeamBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layout_constraintStart_toEndOf="@id/ivTeamLogo"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:text="G10 - Team App" />

                <TextView
                    android:id="@+id/tvProbability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primaryBlue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:text="85%" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Probability Progress Bar -->
            <ProgressBar
                android:id="@+id/progressProbability"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginBottom="8dp"
                android:progressDrawable="@drawable/bg_progress_probability"
                tools:progress="85" />

            <!-- Reason Description -->
            <TextView
                android:id="@+id/tvPlayerReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="12.5sp"
                android:lineSpacingMultiplier="1.25"
                tools:text="Điểm mạnh của dev Cường là khả năng tạo cảm giác an tâm cho mọi người. Dù code có chạy hay không..." />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
