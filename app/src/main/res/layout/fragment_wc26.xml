<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Clean Synchronized Header -->
    <LinearLayout
        android:id="@+id/bannerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/bg_light"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wc26"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="USA • MEXICO • CANADA"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Countdown Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/accent_green" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Còn 12 ngày đến Lễ Khai Mạc" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Symmetric Tab Bar (Exactly 3 Distributed Swapping Tabs) -->
    <LinearLayout
        android:id="@+id/wcTabsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/bannerHeader">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabWcFixtures"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/accent_green"
            android:text="@string/wc_tab_fixtures"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabWcGroups"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:backgroundTint="@color/card_dark"
            android:text="@string/wc_tab_groups"
            android:textColor="@color/text_muted"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabWcVLTT"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/card_dark"
            android:text="@string/wc_tab_bracket"
            android:textColor="@color/text_muted"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- CONTENT 1: Fixtures ScrollView -->
    <ScrollView
        android:id="@+id/scrollWcFixtures"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wcTabsContainer">

        <LinearLayout
            android:id="@+id/layoutWcFixturesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">
        </LinearLayout>

    </ScrollView>

    <!-- CONTENT 2: Groups ScrollView -->
    <ScrollView
        android:id="@+id/scrollWcGroups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wcTabsContainer">

        <LinearLayout
            android:id="@+id/layoutWcGroupsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">
        </LinearLayout>

    </ScrollView>

    <!-- CONTENT 3: Bracket (VLTT) Horizontal ScrollView -->
    <HorizontalScrollView
        android:id="@+id/scrollWcBracket"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wcTabsContainer">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layoutWcBracketContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Column 1: Vòng 1/8 (Round of 16) -->
                <LinearLayout
                    android:id="@+id/colR16"
                    android:layout_width="210dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="top" />

                <!-- Connector 1: R16 -> QF -->
                <LinearLayout
                    android:id="@+id/connCol1"
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />

                <!-- Column 2: Tứ kết (Quarterfinals) -->
                <LinearLayout
                    android:id="@+id/colQF"
                    android:layout_width="210dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="top" />

                <!-- Connector 2: QF -> SF -->
                <LinearLayout
                    android:id="@+id/connCol2"
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />

                <!-- Column 3: Bán kết (Semifinals) -->
                <LinearLayout
                    android:id="@+id/colSF"
                    android:layout_width="210dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="top" />

                <!-- Connector 3: SF -> Final -->
                <LinearLayout
                    android:id="@+id/connCol3"
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />

                <!-- Column 4: Chung kết (Final) -->
                <LinearLayout
                    android:id="@+id/colFinal"
                    android:layout_width="210dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="top" />

            </LinearLayout>

        </ScrollView>

    </HorizontalScrollView>

    <!-- Full Screen / Zoom Toggle Button for VLTT -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWcZoom"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:padding="0dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="#CC222222"
        android:visibility="gone"
        app:icon="@drawable/ic_zoom_in"
        app:iconSize="18dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/text_white"
        app:strokeColor="@color/accent_green"
        app:strokeWidth="1.5dp"
        app:cornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@id/wcTabsContainer"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Full-Screen Loading Overlay (Blocks clicks and centers Lottie) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieLoading"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp"
            app:lottie_rawRes="@raw/loading_football"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

