                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:progressTint="@color/text_muted"
                    tools:progress="50" />

            </LinearLayout>
        </LinearLayout>

        <!-- Blocked Shots Row -->
