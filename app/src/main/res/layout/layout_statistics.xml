                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:progressTint="@color/accent_green"
                    tools:progress="66" />

                <ProgressBar
                    android:id="@+id/progressAwayShotsTarget"
