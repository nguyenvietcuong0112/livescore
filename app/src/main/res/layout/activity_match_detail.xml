<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Top Actions Layout (Back & Share buttons) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTopActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:paddingTop="36dp"
        android:paddingBottom="15dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_white" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Share"
            android:src="@drawable/ic_share"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Tabs -->
    <LinearLayout
        android:id="@+id/tabMainSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopActions">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_tab_main_container"
            android:orientation="horizontal"
            android:padding="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabMatch"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/tab_match"
                android:layout_marginEnd="@dimen/_5sdp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="@color/transparent"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabPrediction"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_5sdp"
                android:text="@string/tab_prediction"
                android:textColor="@color/text_muted"
                android:textStyle="normal"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:backgroundTint="@color/transparent"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/matchHeader"
        layout="@layout/layout_match_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tabMainSelector" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/matchHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Container for Tab 1: Match Content -->
            <LinearLayout
                android:id="@+id/layoutMatchContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Pitch Tracker & Momentum visualizer cards -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <include
                        android:id="@+id/pitchTracker"
                        layout="@layout/layout_pitch_tracker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp" />

                    <!-- Premium Lock Overlay for Pitch Tracker -->
                    <include
                        android:id="@+id/layoutPitchLockOverlay"
                        layout="@layout/layout_premium_lock_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="12dp"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Sub Tab Selector -->
                <LinearLayout
                    android:id="@+id/tabDetailSelector"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="8dp"
                    android:background="@drawable/bg_tab_main_container"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabStats"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:backgroundTint="@color/accentBlue"
                        android:text="@string/tab_stats"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabTimeline"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:backgroundTint="@color/transparent"
                        android:text="@string/tab_timeline"
                        android:textColor="@color/text_muted"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabLineups"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:backgroundTint="@color/transparent"
                        android:text="@string/tab_lineups"
                        android:textColor="@color/text_muted"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp" />

                </LinearLayout>

                <!-- Dynamic content container for layouts -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp">

                    <!-- 1. Stats Layout -->
                    <FrameLayout
                        android:id="@+id/containerStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible">

                        <include
                            android:id="@+id/layoutStats"
                            layout="@layout/layout_statistics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <!-- Premium Lock Overlay for Stats -->
                        <include
                            android:id="@+id/layoutStatsLockOverlay"
                            layout="@layout/layout_premium_lock_overlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!-- 2. Timeline Layout -->
                    <include
                        android:id="@+id/layoutTimeline"
                        layout="@layout/layout_timeline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- 3. Lineup Layout -->
                    <include
                        android:id="@+id/layoutLineups"
                        layout="@layout/layout_lineups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <!-- Container for Tab 2: Prediction Content -->
            <FrameLayout
                android:id="@+id/layoutPredictionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <!-- 1. AI Prediction Detail Layout (visible to VIPs) -->
                <include
                    android:id="@+id/layoutMatchPrediction"
                    layout="@layout/layout_match_prediction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible" />

                <!-- 2. Premium Lock Overlay (visible to non-VIPs) -->
                <include
                    android:id="@+id/layoutPredictionLockOverlay"
                    layout="@layout/layout_premium_lock_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:visibility="gone" />

                <!-- 3. Loading Spinner -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/progressPredictionLoading"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_100sdp"
                    android:layout_gravity="center"
                    android:layout_marginVertical="32dp"
                    app:lottie_rawRes="@raw/loading_data"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
