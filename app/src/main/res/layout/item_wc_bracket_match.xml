<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider_dark"
    app:strokeWidth="1dp"
    app:rippleColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        android:paddingHorizontal="12dp">

        <!-- Date & Time -->
        <TextView
            android:id="@+id/tvMatchDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="29/6, 02:00" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider_dark" />

        <!-- Home Team -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/ivTeam1Logo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Team 1 Logo"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/text_muted"
                tools:tint="@null" />

            <TextView
                android:id="@+id/tvTeam1Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Chưa xác định" />

            <TextView
                android:id="@+id/tvTeam1Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="1" />

        </LinearLayout>

        <!-- Away Team -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivTeam2Logo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Team 2 Logo"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/text_muted"
                tools:tint="@null" />

            <TextView
                android:id="@+id/tvTeam2Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Chưa xác định" />

            <TextView
                android:id="@+id/tvTeam2Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="2" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
