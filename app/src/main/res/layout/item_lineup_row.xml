<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Home Player -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHomePlayerNumber"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@color/divider_dark"
            android:gravity="center"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            tools:text="7" />

        <TextView
            android:id="@+id/tvHomePlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            tools:text="Bukayo Saka" />

    </LinearLayout>

    <!-- Away Player -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAwayPlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            tools:text="Cole Palmer" />

        <TextView
            android:id="@+id/tvAwayPlayerNumber"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@color/divider_dark"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="20" />

    </LinearLayout>

</LinearLayout>
